# Producción (public_html). Angular lo copia al build desde frontend/public;
# en desarrollo no se usa. Todo va en <IfModule> para no romper hostings sin el módulo.

# index.php entrega index.html con los metadatos del restaurante.
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # La API y los archivos que existen se sirven tal cual.
    RewriteRule ^backend/ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Un archivo que no existe (p. ej. un .js de una versión anterior) da 404, no la página.
    RewriteRule \.[a-z0-9]+$ - [L,NC]
    # Cualquier otra ruta (por ejemplo /admin cuando exista el panel) la resuelve Angular.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Los .js y .css del build llevan un hash en el nombre: el navegador los puede guardar un año.
    <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
