# Copia este archivo como .env (en esta misma carpeta) y ajusta los valores.
# El .env tiene contraseñas: nunca se sube a git.
# Comentarios solo en líneas que empiezan con #. Usa comillas si el valor
# tiene espacios o caracteres especiales: DB_PASS="mi#clave;segura"

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurante
DB_USER=restaurante_user
DB_PASS=

# true solo en desarrollo: muestra el detalle de los errores y habilita api/ping.php
APP_DEBUG=false

# Producción: dirección pública del sitio, para las vistas previas al compartir
# el enlace (WhatsApp, Facebook). Ejemplo: https://turestaurante.com
APP_URL=

# Solo si el frontend se sirve desde OTRO dominio que la API. Normalmente vacío.
ALLOWED_ORIGIN=
