$gitignore = @'
# Secretos y configuracion local
.env
backend/config/.env

# Uploads (se conserva la carpeta, no los archivos)
backend/uploads/*
!backend/uploads/.gitkeep

# Angular / Node
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
'@
Set-Content -Path .gitignore -Value $gitignore -Encoding ascii

$envExample = @'
DB_HOST=localhost
DB_NAME=restaurante
DB_USER=root
DB_PASS=
ALLOWED_ORIGIN=http://localhost:4200
'@
Set-Content -Path backend\config\.env.example -Value $envExample -Encoding ascii

git add .
git status